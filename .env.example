# Copy to .env and fill both blank values with your own deployment credentials.
# No administrator account exists until the first administrator uses /api/setup.
POSTGRES_PASSWORD=
ATTENDANCE_DATABASE_URL=
ATTENDANCE_INFERENCE_DEVICE=cpu
# Supported devices: auto, cpu, cuda (NVIDIA Linux), coreml (native macOS).
ATTENDANCE_FACE_THRESHOLD=0.363
# Keep true behind HTTPS. Set false only for loopback HTTP development.
ATTENDANCE_COOKIE_SECURE=true
ATTENDANCE_BIND_ADDRESS=127.0.0.1
ATTENDANCE_PORT=8000
# Trusted HTTPS reverse proxy IP(s), comma-separated; never use * on an exposed app.
FORWARDED_ALLOW_IPS=127.0.0.1
# Frontend build-time face lighting threshold (10..180). Rebuild after changes.
VITE_MIN_FACE_LUMA=45
