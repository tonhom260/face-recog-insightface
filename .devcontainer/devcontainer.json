{
  "name": "Mobile attendance CPU development",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {"version": "22"},
    "ghcr.io/devcontainers/features/git-lfs:1": {"autoPull": false}
  },
  "forwardPorts": [8000, 5173],
  "postCreateCommand": "bash scripts/setup_dev.sh",
  "customizations": {
    "vscode": {
      "settings": {"python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"},
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "remoteUser": "vscode"
}
