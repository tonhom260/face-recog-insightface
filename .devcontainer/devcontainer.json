{
 "name": "InsightFace Pre-Built",  // "build": {
 "image": "my-insightface-dev:latest", 
  // --- เพิ่มบรรทัดนี้ครับ ---
  "runArgs": [
    "--platform=linux/arm64",
    "--name=insightface_dev"
  ],
  // -----------------------
  "forwardPorts": [8000, 3003],
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "remoteUser": "root"
}